# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string. Local dev: mongodb://127.0.0.1:27017/buildai
# Production: a MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URI=

# Any long random string — used to sign JWT auth tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OpenAI API key — used for GPT-4o vision-based fault triage on case submission.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cloudinary credentials — used to store uploaded fault photos.
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port the backend listens on. Defaults to 5000 if unset.
PORT=5000

# Comma-separated list of origins allowed to call this API (CORS).
# Local dev default (matches Vite's dev server) if unset: http://localhost:5173
# In production, set this to your deployed frontend's URL.
FRONTEND_URL=http://localhost:5173
